# Private Docker Registry Configuration
# Registry URL: registry.svc.friasc.com (port 5000)

# Storage configuration (optional)
# REGISTRY_STORAGE_DELETE_ENABLED: "true"
# REGISTRY_STORAGE_MAINTENANCE_READONLY: "false"

# Authentication (optional - uncomment to enable basic auth)
# REGISTRY_AUTH: "htpasswd"
# REGISTRY_AUTH_HTPASSWD_PATH: "/auth/htpasswd"
# REGISTRY_AUTH_HTPASSWD_REALM: "Registry Realm"

# HTTP headers (optional)
# REGISTRY_HTTP_HEADERS_X-Content-Type-Options: "[nosniff]"
# REGISTRY_HTTP_HEADERS_X-XSS-Protection: "1; mode=block"
